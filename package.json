{
  "name": "shop-cloudflare",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:worker": "npm run build && wrangler dev",
    "build": "vite build",
    "deploy": "npm run build && wrangler deploy",
    "db:local": "wrangler d1 migrations apply APP_DB --local",
    "db:remote": "wrangler d1 migrations apply APP_DB --remote"
  },
  "dependencies": {
    "hono": "^4.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.0.0"
  }
}
